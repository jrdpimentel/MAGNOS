<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Leave empty to find the server automatically on the local network. -->
    <add key="ServerUrl" value="" />
    <!-- Must match Cafe:ClientKey in the server's appsettings.json. -->
    <add key="ClientKey" value="" />
    <!-- Leave empty to auto-name from the IP's last octet (192.168.1.101 -> PC-01). No spaces. -->
    <add key="ClientName" value="" />
    <!-- Seconds on the lock screen with no activity before the PC shuts down. 0 = disabled. -->
    <add key="AutoShutDownInterval" value="300" />
    <!-- True = normal window, no lock-down (for trying things out). False = real customer mode. -->
    <add key="TestMode" value="False" />
    <add key="AccountCreationAllowed" value="True" />
  </appSettings>
</configuration>
